---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { whatsappUrl } from '../data/site';
---

<Layout title="Page not found | Muhammad Zaheeb" description="This page does not exist." noindex>
  <Header />
  <main id="main" class="wrap nf" tabindex="-1">
    <div class="ring" aria-hidden="true"></div>
    <h1 class="h1">That page isn’t here.</h1>
    <p class="text">The link may be old, or the address may have a typo.</p>
    <div class="actions">
      <a href="/" class="btn btn-solid">Go to the home page</a>
      <a href="/#work" class="btn btn-line">See the work</a>
      <a href={whatsappUrl} class="btn btn-line">Message me on WhatsApp</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .nf {
    position: relative;
    min-height: 68vh;
    padding-block: var(--section) 0;
    text-align: center;
  }
  /* A bare photon ring: a thin gold circle around nothing. */
  .ring {
    width: clamp(96px, 14vw, 150px);
    aspect-ratio: 1;
    margin: 0 auto 48px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    box-shadow:
      0 0 44px rgb(233 201 143 / 0.25),
      inset 0 0 24px rgb(233 201 143 / 0.18);
  }
  h1 {
    max-width: 900px;
    margin-inline: auto;
  }
  .text {
    margin-top: 24px;
    color: var(--text-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 40px;
  }
</style>
