---
import { Image } from 'astro:assets';
import photo from '../assets/zaheeb-cutout.png';
import { site, stack } from '../data/site';

// Faint stars, placed in a 400 × 500 field. [x, y, diameter, delay in seconds]
const stars = [
  [40, 60, 2.4, 0],
  [352, 44, 2, 0],
  [312, 300, 2.6, 1.2],
  [70, 320, 2, 2],
  [250, 28, 2.2, 0.6],
  [22, 200, 2, 2.6],
];
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="wrap grid">
    <div class="portrait" data-portrait>
      {/* Each ring is its own layer, so rotating it costs the compositor almost nothing. */}
      <svg class="orbit" aria-hidden="true" viewBox="0 0 400 400">
        <circle cx="200" cy="200" r="170" fill="none" stroke="rgb(233 201 143 / 0.16)" stroke-dasharray="2 7"></circle>
        <circle cx="370" cy="200" r="3" fill="#e9c98f"></circle>
      </svg>
      <svg class="orbit reverse" aria-hidden="true" viewBox="0 0 400 400">
        <circle cx="200" cy="200" r="122" fill="none" stroke="rgb(233 201 143 / 0.28)"></circle>
        <circle cx="78" cy="200" r="2.4" fill="#ece7df"></circle>
      </svg>
      <svg class="halo" aria-hidden="true" viewBox="0 0 400 400">
        <circle cx="200" cy="200" r="86" fill="none" stroke="#e9c98f" stroke-width="1.5"></circle>
      </svg>
      {
        stars.map(([x, y, d, delay]) => (
          <span class="star" aria-hidden="true" style={`left:${x / 4}%;top:${y / 5}%;width:${d}px;height:${d}px;animation-delay:${delay}s`} />
        ))
      }
      <Image
        src={photo}
        alt="Muhammad Zaheeb, arms crossed, wearing sunglasses and a quilted vest"
        widths={[360, 540, 756]}
        sizes="(min-width: 600px) 360px, 66vw"
        format="webp"
        quality={86}
        loading="lazy"
        class="photo"
      />
    </div>

    <div class="text">
      <h2 id="about-title" class="h2">About</h2>
      <p class="line display">I like problems where nearly right is not good enough.</p>
      <p class="body">
        {site.degree} student at <span class="nowrap">{site.university}</span>, class of {site.classOf}. I build web apps with
        React, TypeScript, Python, FastAPI and PostgreSQL, wrote a linked-list text editor in C++, and directed Event Horizon,
        which runs on WebGL2 and GLSL.
      </p>
      <h3>Stack</h3>
      <ul class="stack">
        {stack.map((s) => <li>{s}</li>)}
      </ul>
      <p class="elsewhere">
        <a href={site.github} class="tap" rel="noopener">GitHub</a>
        <a href={site.linkedin} class="tap" rel="noopener">LinkedIn</a>
      </p>
    </div>
  </div>
</section>

<script>
  import { whileVisible } from '../scripts/while-visible';
  const portrait = document.querySelector<HTMLElement>('[data-portrait]');
  if (portrait) {
    whileVisible(
      portrait,
      () => (portrait.dataset.motion = 'running'),
      () => (portrait.dataset.motion = 'paused'),
    );
  }
</script>

<style>
  .about {
    padding-top: var(--section);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
    gap: 48px 72px;
    align-items: center;
  }
  .portrait {
    position: relative;
    width: 100%;
    max-width: 540px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    contain: layout paint;
    background: #000;
  }
  /* The orbits are centred behind the head, 34% down the frame. */
  .orbit,
  .halo {
    position: absolute;
    top: -6%;
    left: 0;
    width: 100%;
    aspect-ratio: 1;
  }
  .orbit {
    animation: orbit 48s linear infinite;
  }
  .reverse {
    animation-duration: 30s;
    animation-direction: reverse;
  }
  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }
  .halo {
    animation: halo 6s ease-in-out infinite;
  }
  @keyframes halo {
    50% {
      opacity: 0.35;
    }
  }
  .star {
    position: absolute;
    border-radius: 50%;
    background: var(--text);
    animation: twinkle 4s ease-in-out infinite;
  }
  @keyframes twinkle {
    50% {
      opacity: 0.15;
    }
  }
  /* Nothing moves until the portrait is on screen in a visible tab. */
  :global(.js) .portrait:not([data-motion='running']) > * {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit,
    .halo,
    .star {
      animation: none;
    }
  }
  .portrait :global(.photo) {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: auto;
    max-width: none;
    height: 88%;
    transform: translateX(-50%);
    /* The cutout ends at the waist; let it sink into the black. */
    mask-image: linear-gradient(180deg, #000 82%, transparent);
  }

  .line {
    max-width: 600px;
    margin-top: 28px;
    font-size: 1.875rem;
    font-style: italic;
    line-height: 1.3;
  }
  .body {
    max-width: 560px;
    margin-top: 20px;
    color: var(--text-2);
  }
  .nowrap {
    white-space: nowrap;
  }
  h3 {
    margin-top: 36px;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 400;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    max-width: 560px;
    margin-top: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }
  .elsewhere {
    display: flex;
    gap: 28px;
    margin-top: 20px;
  }
  @media print {
    .orbit,
    .halo,
    .star {
      display: none;
    }
    .portrait {
      display: none;
    }
  }
</style>
