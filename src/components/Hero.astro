---
import ArrowDown from '@lucide/astro/icons/arrow-down';
import { site, whatsappUrl } from '../data/site';

// Only confirmed facts. City and availability appear once the owner fills them in.
const facts = [
  { term: 'Builds', detail: 'Websites and web apps' },
  { term: 'Stack', detail: 'React, TypeScript, Python, FastAPI, PostgreSQL' },
  { term: 'Studying', detail: site.education },
  { term: site.city ? 'Based in' : 'Languages', detail: site.city || site.languages },
];
---

<section class="hero wrap" aria-labelledby="hero-title">
  {
    site.availability && (
      <p class="availability small">
        <span class="dot" aria-hidden="true" />
        {site.availability}
      </p>
    )
  }

  <h1 id="hero-title" class="display hero-title">
    I build websites and web&nbsp;apps for <em>small businesses</em>.
  </h1>

  <div class="hero-foot grid-12">
    <div class="actions">
      <a href={whatsappUrl} class="btn btn-primary">Talk on WhatsApp</a>
      <a href="#work" class="link-quiet inline-flex items-center gap-1.5 font-medium">
        See selected work <ArrowDown size={16} aria-hidden="true" />
      </a>
    </div>
    <p class="lead hero-lead">
      Cafes, clinics, shops and service businesses: a fast, mobile-friendly site or a custom web app, with a written
      quote before any work starts.
    </p>
  </div>

  <dl class="facts">
    {
      facts.map((f) => (
        <div>
          <dt class="label">{f.term}</dt>
          <dd>{f.detail}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .hero {
    padding-top: clamp(3rem, 1.5rem + 6vw, 7.5rem);
    padding-bottom: clamp(4rem, 3rem + 5vw, 7rem);
  }
  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
    color: var(--text-2);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .hero-title {
    max-width: 15.5em;
  }
  .hero-title em {
    font-style: italic;
    letter-spacing: -0.02em;
  }
  .hero-foot {
    margin-top: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    padding-top: clamp(1.5rem, 1rem + 1.5vw, 2rem);
    border-top: 1px solid var(--border);
    row-gap: 2rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
    border-top: 1px solid var(--border);
  }
  .facts > div {
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .facts > div:nth-child(odd) {
    border-right: 1px solid var(--border);
  }
  .facts > div:nth-child(even) {
    padding-left: 1rem;
  }
  .facts dd {
    margin-top: 0.4rem;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--text);
  }
  @media (min-width: 48rem) {
    .actions {
      grid-column: 1 / span 5;
      align-self: start;
    }
    .hero-lead {
      grid-column: 7 / span 6;
    }
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-bottom: 1px solid var(--border);
    }
    .facts > div,
    .facts > div:nth-child(even) {
      padding: 1.1rem 1.25rem 1.25rem;
      border-bottom: 0;
      border-right: 1px solid var(--border);
    }
    .facts > div:first-child {
      padding-left: 0;
    }
    .facts > div:last-child {
      border-right: 0;
    }
    .facts dd {
      font-size: var(--step-0);
    }
  }
</style>
