---
import SectionHead from './SectionHead.astro';

// Answers confirmed by the owner. Keep this list to real policies only.
const faqs = [
  {
    q: 'Who owns the website when it is finished?',
    a: 'You do. Once the final payment is made, the site, its code, its content and the domain all belong to you.',
  },
  {
    q: 'Are hosting and the domain included in the price?',
    a: 'No. You pay for them directly, in your own name, so you always stay in control of them. I set everything up for you, and where a free hosting plan is enough, I use it.',
  },
  {
    q: 'How does payment work?',
    a: 'Half the agreed price to start, and the other half before the site goes live.',
  },
  {
    q: 'How many changes can I ask for?',
    a: 'Two rounds of changes during the build. You see a live preview every week, so changes come early, while they are still easy to make.',
  },
  {
    q: 'What happens after launch?',
    a: 'If anything breaks in the first 30 days after launch, I fix it for free.',
  },
  {
    q: 'How long does it take?',
    a: 'A business website usually takes one to two weeks. A site with a menu or booking details takes about two weeks, and a custom web app three to six weeks. You get a firm timeline with the written quote.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const faqLdJson = JSON.stringify(faqLd).replace(/</g, '\\u003c');
---

<section id="faq" class="section wrap" aria-labelledby="faq-title">
  <SectionHead id="faq-title" num="04" label="Questions" title="Before you ask" />

  <div class="list grid-12">
    <div class="items">
      {
        faqs.map((f) => (
          <details class="item reveal avoid-break">
            <summary class="q">
              <span>{f.q}</span>
              <span class="sign" aria-hidden="true" />
            </summary>
            <p class="a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>

  <script type="application/ld+json" set:html={faqLdJson} />
</section>

<style>
  .section {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }
  .list {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }
  .items {
    border-bottom: 1px solid var(--border);
  }
  .item {
    border-top: 1px solid var(--border);
  }
  .q {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(1.1rem, 0.9rem + 0.8vw, 1.5rem);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.35;
    letter-spacing: -0.005em;
    min-height: 44px;
  }
  .q::-webkit-details-marker {
    display: none;
  }
  .q:hover {
    color: var(--accent);
  }
  .sign {
    position: relative;
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    align-self: center;
  }
  .sign::before,
  .sign::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1px;
    background: currentColor;
    transition: transform 200ms ease;
  }
  .sign::after {
    transform: rotate(90deg);
  }
  details[open] .sign::after {
    transform: rotate(0deg);
  }
  .a {
    max-width: 60ch;
    padding-bottom: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    color: var(--text-2);
  }
  @media (min-width: 48rem) {
    .items {
      grid-column: 4 / span 8;
    }
  }
  @media print {
    .sign {
      display: none;
    }
  }
</style>
