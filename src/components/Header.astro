---
import { nav, site } from '../data/site';

interface Props {
  /** Label of the nav item for the current page, e.g. "Work" on case studies. */
  current?: string;
  /** On the home page the wordmark jumps to the top instead of reloading. */
  home?: boolean;
}
const { current, home = false } = Astro.props;
---

<header class="site-header wrap">
  <a href={home ? '#top' : '/'} class="wordmark display">{site.name}</a>
  <nav aria-label="Main" class="no-print">
    <ul>
      {
        nav.map((n) => (
          <li>
            <a
              href={home ? n.href.slice(1) : n.href}
              class:list={{ contact: n.label === 'Contact' }}
              aria-current={n.label === current ? 'true' : undefined}
            >
              {n.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 4px 32px;
    padding-top: 26px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    font-size: 1.625rem;
    line-height: 1.2;
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(14px, 2.2vw, 28px);
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    font-size: 0.9375rem;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.5em;
  }
  nav a:hover,
  nav a[aria-current] {
    text-decoration-color: var(--gold);
  }
  nav a.contact {
    color: var(--gold);
  }
  @media (max-width: 400px) {
    nav a {
      font-size: 0.875rem;
    }
  }
</style>
