---
import '../styles/global.css';
import displayUrl from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-normal.woff2?url';
import sansUrl from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Slug of the generated Open Graph image in /og/, e.g. "home" or a project slug. */
  og?: string;
  ogType?: 'website' | 'article';
  /** Alt text for the Open Graph image. Describes the card, not the page title. */
  ogAlt?: string;
  jsonLd?: Record<string, unknown>[];
  /** Keep the page out of search results and skip canonical and og:url (used by the 404 page). */
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  og = 'home',
  ogType = 'website',
  ogAlt = 'Muhammad Zaheeb. Software that bends to the rules. A rendered black hole behind the name.',
  jsonLd = [],
  noindex = false,
} = Astro.props;

// Absolute URLs need the production domain (SITE_URL). Without it, fall back to root-relative paths.
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = abs(`/og/${og}.jpg`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="author" content={site.name} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}

    <link rel="preload" href={displayUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <slot name="head" />

    {/* Marks that scripts run, so script-only controls can be hidden without them. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
  </head>
  <body class="min-h-screen">
    <a href="#main" class="skip btn btn-solid no-print fixed left-3 top-3 z-50">Skip to content</a>
    <slot />
  </body>
</html>
