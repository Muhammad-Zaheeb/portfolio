---
import MessageCircle from '@lucide/astro/icons/message-circle';
import Mail from '@lucide/astro/icons/mail';
import { site, whatsappUrl, mailUrl } from '../data/site';
---

<section id="contact" class="mx-auto max-w-5xl scroll-mt-16 px-4 py-16">
  <h2 class="text-2xl font-semibold tracking-tight">Contact</h2>
  <p class="mt-2 max-w-xl text-muted">The fastest way to reach me is WhatsApp. I usually reply the same day.</p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href={whatsappUrl}
      class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-3 font-medium text-accent-fg"
    >
      <MessageCircle size={18} aria-hidden="true" />
      WhatsApp {site.whatsappDisplay}
    </a>
    <a
      href={mailUrl}
      class="inline-flex items-center gap-2 rounded-md border border-border px-5 py-3 font-medium hover:bg-surface"
    >
      <Mail size={18} aria-hidden="true" />
      {site.email}
    </a>
  </div>
  <p class="mt-6 text-sm">
    <a href={site.linkedin} class="text-accent hover:underline">LinkedIn</a>
    &nbsp;|&nbsp;
    <a href={site.github} class="text-accent hover:underline">GitHub</a>
  </p>
  <!-- Contact form is added in Phase 4 (needs a Web3Forms key) -->
</section>
