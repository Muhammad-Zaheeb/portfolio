---
import { Image } from 'astro:assets';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import SectionHead from './SectionHead.astro';
import { projects } from '../data/site';
import novachat from '../assets/novachat.jpg';
import campusflow from '../assets/campusflow.jpg';

const images = { novachat, campusflow } as const;
---

<section id="work" class="section wrap" aria-labelledby="work-title">
  <SectionHead id="work-title" num="01" label="Work" title="Selected work">
    Two projects I built end to end. Both are live, and the code is public.
  </SectionHead>

  <ol class="rows">
    {
      projects.map((p, i) => (
        <li class="row grid-12 reveal">
          <figure class="row-image frame">
            <Image
              src={images[p.slug as keyof typeof images]}
              alt={p.imageAlt}
              widths={[480, 800]}
              sizes="(min-width: 48rem) 56vw, 100vw"
              format="webp"
              loading="lazy"
            />
          </figure>
          <div class="row-text">
            <p class="numeral row-num">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="row-title">
              <a href={`/work/${p.slug}`}>{p.title}</a>
            </h3>
            <p class="row-summary">{p.summary}</p>
            <dl class="row-meta small">
              <div>
                <dt class="label">Stack</dt>
                <dd>{p.stackShort}</dd>
              </div>
              <div>
                <dt class="label">Proof</dt>
                <dd>{p.proof}</dd>
              </div>
            </dl>
            <div class="row-links">
              <a href={`/work/${p.slug}`} class="link-quiet inline-flex items-center gap-1.5 font-medium">
                Read the case study <ArrowRight size={16} aria-hidden="true" />
                <span class="sr-only">: {p.title}</span>
              </a>
              <a href={p.live} class="link inline-flex items-center gap-1" rel="noopener">
                Live site<span class="sr-only"> for {p.title}</span> <ArrowUpRight size={15} aria-hidden="true" />
              </a>
              <a href={p.github} class="link inline-flex items-center gap-1" rel="noopener">
                Code<span class="sr-only"> for {p.title}</span> <ArrowUpRight size={15} aria-hidden="true" />
              </a>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="small footnote">Both apps run on free hosting and can take about a minute to wake up on the first visit.</p>
</section>

<style>
  .section {
    padding-block: clamp(4rem, 3rem + 5vw, 8rem);
  }
  .rows {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .row {
    position: relative;
    row-gap: 1.5rem;
    padding-block: clamp(2rem, 1.5rem + 2.5vw, 4rem);
    border-top: 1px solid var(--border);
  }
  .row-image {
    margin: 0;
  }
  .row-num {
    font-size: var(--step-2);
  }
  .row-title {
    margin-top: 0.75rem;
    font-size: var(--step-3);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .row-title a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
    transition: text-decoration-color 150ms ease;
  }
  .row-title a:hover {
    text-decoration-color: var(--accent);
  }
  .row-summary {
    margin-top: 1rem;
    max-width: 40ch;
    color: var(--text-2);
  }
  .row-meta {
    margin-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .row-meta > div {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--border);
  }
  .row-meta dt {
    padding-top: 0.15em;
  }
  .row-meta dd {
    color: var(--text);
  }
  .row-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
    font-size: var(--step--1);
  }
  .row-links a:first-child {
    font-size: var(--step-0);
    flex-basis: 100%;
  }
  .footnote {
    color: var(--muted);
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  @media (min-width: 48rem) {
    .row {
      align-items: start;
    }
    .row-text {
      grid-column: 1 / span 5;
      grid-row: 1;
    }
    .row-image {
      grid-column: 6 / span 7;
      grid-row: 1;
    }
  }
</style>
