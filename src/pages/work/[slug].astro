---
import { Image } from 'astro:assets';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/site';
import { projectLd } from '../../data/schema';
import novachat from '../../assets/novachat.jpg';
import campusflow from '../../assets/campusflow.jpg';
import galiNau from '../../assets/gali-nau.jpg';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, next: projects[(i + 1) % projects.length] },
  }));
}

const { p, next } = Astro.props;
const images = { novachat, campusflow, 'gali-nau': galiNau } as const;
const image = images[p.slug as keyof typeof images];
const sections = [
  { heading: 'Problem', text: p.problem },
  { heading: 'Solution', text: p.solution },
];
---

<Layout
  title={`${p.title} case study | Muhammad Zaheeb`}
  description={p.seoDescription}
  og={p.slug}
  ogType="article"
  ogAlt={`Case study card: ${p.title}. ${p.summary}`}
  jsonLd={[projectLd(p, Astro.site)]}
>
  <Header current="Work" />
  <main id="main">
    <article>
      <header class="wrap intro">
        <a href="/#work" class="link-quiet back inline-flex items-center gap-1.5 font-medium no-print">
          <ArrowLeft size={16} aria-hidden="true" /> All work
        </a>
        <p class="label mt-10">{p.fictional ? 'Concept demo' : 'Case study'}</p>
        <h1 class="display title">{p.title}</h1>
        <p class="lead mt-6">{p.summary}</p>
        {p.notice && <p class="notice mt-4">{p.notice}</p>}

        <dl class="facts">
          <div>
            <dt class="label">Type</dt>
            <dd>{p.type}</dd>
          </div>
          <div>
            <dt class="label">Stack</dt>
            <dd>{p.stackShort}</dd>
          </div>
          <div>
            <dt class="label">Proof</dt>
            <dd>{p.proof}</dd>
          </div>
          <div>
            <dt class="label">Links</dt>
            <dd class="links">
              {
                p.live && (
                  <a href={p.live} class="link inline-flex items-center gap-1" rel="noopener">
                    Live site <ArrowUpRight size={14} aria-hidden="true" />
                  </a>
                )
              }
              {
                p.repos.map((r) => (
                  <a href={r.href} class="link inline-flex items-center gap-1" rel="noopener">
                    {r.label} <ArrowUpRight size={14} aria-hidden="true" />
                  </a>
                ))
              }
            </dd>
          </div>
        </dl>
        {p.freeHosted && <p class="small wake">Free-hosted apps can take about a minute to wake up on the first visit.</p>}
      </header>

      <figure class="wrap shot grid-12">
        <div class="frame shot-frame">
          <Image
            src={image}
            alt={p.imageAlt}
            widths={[480, 800]}
            sizes="(min-width: 48rem) 75vw, 100vw"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </figure>

      <div class="wrap body">
        {
          sections.map((s) => (
            <section class="part grid-12 avoid-break">
              <h2 class="label part-label">{s.heading}</h2>
              <p class="part-text">{s.text}</p>
            </section>
          ))
        }
        <section class="part grid-12 avoid-break">
          <h2 class="label part-label">Stack</h2>
          <dl class="part-text stack">
            {
              p.stack.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>
        </section>
        <section class="part grid-12 avoid-break">
          <h2 class="label part-label">Result</h2>
          <p class="part-text">{p.outcome}</p>
        </section>
      </div>
    </article>

    <nav class="wrap next no-print" aria-label="Next case study">
      <div class="grid-12 next-inner">
        <p class="label next-label">Next case study</p>
        <a href={`/work/${next.slug}`} class="next-link">
          <span>{next.title}</span>
          <ArrowRight size={28} aria-hidden="true" />
        </a>
      </div>
    </nav>

    <Contact compact />
  </main>
  <Footer />
</Layout>

<style>
  .intro {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .back {
    font-size: var(--step--1);
  }
  .title {
    margin-top: 0.75rem;
  }
  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border-top: 1px solid var(--border);
  }
  .facts > div {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--border);
    font-size: var(--step--1);
  }
  .facts dt {
    padding-top: 0.15em;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
  }
  @media (pointer: coarse) {
    .links {
      row-gap: 0;
    }
  }
  .notice {
    color: var(--text-2);
    font-style: italic;
    font-size: var(--step-0);
  }
  .wake {
    margin-top: 1rem;
    color: var(--muted);
  }
  .shot {
    margin-block: clamp(2.5rem, 2rem + 3vw, 4.5rem) 0;
  }
  .body {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .part {
    row-gap: 0.75rem;
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-top: 1px solid var(--border);
  }
  .part-label {
    font-family: var(--font-body);
    padding-top: 0.3em;
  }
  .part-text {
    max-width: 62ch;
    color: var(--text-2);
  }
  p.part-text {
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .stack > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--border);
  }
  .stack > div:first-child {
    padding-top: 0;
  }
  .stack dt {
    color: var(--text);
    font-weight: 550;
  }
  .next-inner {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-top: 1px solid var(--border);
    row-gap: 0.75rem;
    align-items: baseline;
  }
  .next-link {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    min-width: 0;
    overflow-wrap: break-word;
    font-family: var(--font-serif);
    font-size: var(--step-3);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
    transition: text-decoration-color 150ms ease, color 150ms ease;
  }
  .next-link:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  @media (min-width: 48rem) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-bottom: 1px solid var(--border);
    }
    .facts > div {
      display: block;
      padding: 1rem 1.25rem 1.25rem;
      border-bottom: 0;
      border-right: 1px solid var(--border);
    }
    .facts > div:first-child {
      padding-left: 0;
    }
    .facts > div:last-child {
      border-right: 0;
    }
    .facts dd {
      margin-top: 0.45rem;
    }
    .shot-frame {
      grid-column: 4 / span 9;
    }
    .part-label,
    .next-label {
      grid-column: 1 / span 3;
    }
    .part-text,
    .next-link {
      grid-column: 4 / span 8;
    }
  }
</style>
