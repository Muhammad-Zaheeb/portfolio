---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { whatsappUrl } from '../data/site';
---

<Layout title="Page not found | Muhammad Zaheeb" description="This page does not exist." noindex>
  <Header />
  <main id="main" class="wrap nf">
    <p class="label">Error 404</p>
    <h1 class="display mt-4">That page isn't here.</h1>
    <p class="lead mt-6">The link may be old, or the address may have a typo.</p>
    <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 font-medium">
      <li><a href="/" class="link">Go to the home page</a></li>
      <li><a href="/#work" class="link">See selected work</a></li>
      <li><a href={whatsappUrl} class="link">Message me on WhatsApp</a></li>
    </ul>
  </main>
  <Footer />
</Layout>

<style>
  .nf {
    min-height: 70vh;
    padding-block: clamp(4rem, 3rem + 6vw, 9rem);
  }
</style>
