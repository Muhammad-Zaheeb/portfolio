---
import { services } from '../data/site';
---

<section id="services" class="mx-auto max-w-5xl scroll-mt-16 px-4 py-16">
  <h2 class="text-2xl font-semibold tracking-tight">Services</h2>
  <p class="mt-2 max-w-xl text-muted">
    Prices are starting points; every project gets a fixed quote after a short chat.
  </p>
  <div class="mt-8 grid gap-6 md:grid-cols-3">
    {services.map((s) => (
      <article class="flex flex-col rounded-lg border border-border bg-surface p-6">
        <h3 class="font-semibold">{s.title}</h3>
        <p class="mt-3 text-lg font-semibold text-accent">{s.price}</p>
        <p class="text-sm text-muted">Typical delivery: {s.time}</p>
        <ul class="mt-4 space-y-2 text-sm">
          {s.points.map((pt) => <li>{pt}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>
