---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer id="footer" class="footer wrap">
  <p>{site.name}, {year}</p>
  <ul class="no-print">
    <li><a href={site.github} class="tap" rel="noopener">GitHub</a></li>
    <li><a href={site.linkedin} class="tap" rel="noopener">LinkedIn</a></li>
    <li><a href="#top" class="tap">Back to top</a></li>
  </ul>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 24px;
    margin-top: clamp(80px, 10vw, 140px);
    padding-bottom: 48px;
    color: var(--dim);
    font-size: 0.875rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }
  .footer a {
    color: var(--muted);
    text-decoration-color: transparent;
  }
  .footer a:hover {
    color: var(--text);
    text-decoration-color: currentColor;
  }
</style>
