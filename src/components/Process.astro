---
import { process } from '../data/site';
---

<section id="process" class="mx-auto max-w-5xl scroll-mt-16 px-4 py-16">
  <h2 class="text-2xl font-semibold tracking-tight">How I work</h2>
  <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {process.map((s, i) => (
      <li class="rounded-lg border border-border p-5">
        <span class="text-sm font-medium text-accent">Step {i + 1}</span>
        <h3 class="mt-1 font-semibold">{s.title}</h3>
        <p class="mt-2 text-sm text-muted">{s.text}</p>
      </li>
    ))}
  </ol>
</section>
