---
import SectionHead from './SectionHead.astro';
import { services, whatsappUrl } from '../data/site';
---

<section id="services" class="section wrap" aria-labelledby="services-title">
  <SectionHead id="services-title" num="02" label="Services" title="What I can build for you">
    Prices are starting points. Every project gets a fixed written quote after a short chat. All prices are in US
    dollars.
  </SectionHead>

  <ul class="list">
    {
      services.map((s) => (
        <li class="item grid-12 reveal avoid-break">
          <div class="name">
            <h3 class="h3">{s.title}</h3>
            <p class="desc">{s.summary}</p>
          </div>
          <ul class="points">
            {s.points.map((pt) => <li>{pt}</li>)}
          </ul>
          <p class="time small">
            <span class="label">Typical time</span>
            <span>{s.time}</span>
          </p>
          <p class="price">
            <span class="from">from</span> <span class="tnum">${s.price}</span>
          </p>
        </li>
      ))
    }
  </ul>

  <p class="note">
    Not sure which fits? Tell me about the project and I will say honestly which option makes sense, including when
    something simpler is enough. <a href={whatsappUrl} class="link whitespace-nowrap">Ask on WhatsApp</a>
  </p>
</section>

<style>
  .section {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }
  .list {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border-bottom: 1px solid var(--border);
  }
  .item {
    grid-template-areas:
      'name price'
      'time time'
      'points points';
    grid-template-columns: minmax(0, 1fr) auto;
    row-gap: 1rem;
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border-top: 1px solid var(--border);
  }
  .name {
    grid-area: name;
  }
  .desc {
    margin-top: 0.5rem;
    max-width: 38ch;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .points {
    grid-area: points;
    color: var(--text-2);
  }
  .points li {
    position: relative;
    padding-left: 1.1rem;
  }
  .points li + li {
    margin-top: 0.3rem;
  }
  .points li::before {
    content: '\2013';
    position: absolute;
    left: 0;
    color: var(--muted);
  }
  .time {
    grid-area: time;
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    color: var(--text-2);
  }
  .price {
    grid-area: price;
    justify-self: end;
    font-size: var(--step-1);
    font-weight: 550;
    letter-spacing: -0.01em;
    white-space: nowrap;
    line-height: 1.3;
  }
  .from {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--muted);
  }
  .note {
    margin-top: 2rem;
    max-width: 62ch;
    color: var(--text-2);
  }
  @media (min-width: 48rem) {
    .item {
      grid-template-areas: none;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: baseline;
    }
    .name {
      grid-area: auto;
      grid-column: 1 / span 4;
    }
    .points {
      grid-area: auto;
      grid-column: 5 / span 4;
    }
    .time {
      grid-area: auto;
      grid-column: 9 / span 2;
      flex-direction: column;
      gap: 0.35rem;
    }
    .price {
      grid-area: auto;
      grid-column: 11 / span 2;
    }
    .note {
      margin-left: calc((100% + var(--col-gap)) / 12 * 3);
    }
  }
</style>
