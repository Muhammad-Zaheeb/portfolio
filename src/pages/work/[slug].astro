---
import { Image } from 'astro:assets';
import ExternalLink from '@lucide/astro/icons/external-link';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/site';
import novachat from '../../assets/novachat.jpg';
import campusflow from '../../assets/campusflow.jpg';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const images = { novachat, campusflow } as const;
const image = images[p.slug as keyof typeof images];
const sections = [
  { heading: 'Problem', text: p.problem },
  { heading: 'Solution', text: p.solution },
];
---

<Layout title={`${p.title} case study | Muhammad Zaheeb`} description={p.seoDescription}>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
    <a href="/#work" class="inline-flex items-center gap-1 text-sm font-medium text-accent hover:underline">
      <ArrowLeft size={14} aria-hidden="true" /> Back to Work
    </a>
    <h1 class="mt-6 text-3xl font-semibold tracking-tight sm:text-4xl">{p.title}</h1>
    <p class="mt-3 text-lg text-muted">{p.summary}</p>

    <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
      <a href={p.live} class="inline-flex items-center gap-1 text-accent hover:underline">
        Open live site <ExternalLink size={14} aria-hidden="true" />
      </a>
      {p.repos.map((r) => <a href={r.href} class="text-accent hover:underline">{r.label}</a>)}
    </div>
    <p class="mt-3 text-sm text-muted">
      Free-hosted apps may take about a minute to wake up on the first visit.
    </p>

    <Image
      src={image}
      alt={p.imageAlt}
      width={800}
      height={500}
      format="webp"
      class="mt-8 h-auto w-full rounded-lg border border-border"
    />

    <div class="mt-10 space-y-8">
      {sections.map((s) => (
        <section>
          <h2 class="text-xl font-semibold tracking-tight">{s.heading}</h2>
          <p class="mt-2 text-muted">{s.text}</p>
        </section>
      ))}
      <section>
        <h2 class="text-xl font-semibold tracking-tight">Tech</h2>
        <dl class="mt-3 divide-y divide-border rounded-lg border border-border bg-surface text-sm">
          {p.stack.map(([k, v]) => (
            <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:gap-4">
              <dt class="w-28 shrink-0 font-medium">{k}</dt>
              <dd class="text-muted">{v}</dd>
            </div>
          ))}
        </dl>
      </section>
      <section>
        <h2 class="text-xl font-semibold tracking-tight">Result</h2>
        <p class="mt-2 text-muted">{p.outcome}</p>
      </section>
    </div>

    <a href="/#work" class="mt-12 inline-flex items-center gap-1 text-sm font-medium text-accent hover:underline">
      <ArrowLeft size={14} aria-hidden="true" /> Back to Work
    </a>
  </main>
  <Footer />
</Layout>
