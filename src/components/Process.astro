---
import { process } from '../data/site';
---

<section id="process" aria-labelledby="process-title">
  <h2 id="process-title" class="h2">How we work together</h2>
  <ol>
    {
      process.map((s, i) => (
        <li>
          <span class="num display" aria-hidden="true">
            {i + 1}
          </span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  h2 {
    font-size: clamp(2.75rem, 4.4vw, 4rem);
  }
  ol {
    margin-top: 40px;
  }
  li {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    padding-block: 20px;
    border-top: 1px solid var(--rule);
  }
  li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .num {
    color: var(--gold);
    font-size: 1.875rem;
    line-height: 1.1;
    font-variant-numeric: lining-nums;
  }
  h3 {
    font-size: 1.125rem;
    font-weight: 500;
  }
  p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 1rem;
  }
</style>
