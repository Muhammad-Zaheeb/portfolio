---
import { faqs } from '../data/site';
import { faqLd } from '../data/schema';

const json = JSON.stringify(faqLd()).replace(/</g, '\\u003c');
---

<section id="faq" aria-labelledby="faq-title">
  <h2 id="faq-title" class="h2">Questions</h2>
  <dl>
    {
      faqs.map((f) => (
        <div>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))
    }
  </dl>
  <script type="application/ld+json" set:html={json} />
</section>

<style>
  h2 {
    font-size: clamp(2.75rem, 4.4vw, 4rem);
  }
  dl {
    margin-top: 40px;
  }
  dl > div {
    padding-block: 20px;
    border-top: 1px solid var(--rule);
  }
  dl > div:last-child {
    border-bottom: 1px solid var(--rule);
  }
  dt {
    font-weight: 500;
  }
  dd {
    max-width: 60ch;
    margin-top: 4px;
    color: var(--muted);
  }
</style>
