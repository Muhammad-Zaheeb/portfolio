---
interface Props {
  id: string;
  num: string;
  label: string;
  title: string;
}
const { id, num, label, title } = Astro.props;
---

<div class="section-head grid-12">
  <p class="label" aria-hidden="true"><span class="tnum">{num}</span>&ensp;{label}</p>
  <h2 id={id} class="h2">{title}</h2>
  {
    Astro.slots.has('default') && (
      <div class="lead mt-1">
        <slot />
      </div>
    )
  }
</div>
