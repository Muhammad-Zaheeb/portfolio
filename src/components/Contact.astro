---
import { site, whatsappUrl, mailUrl, web3formsKey, web3formsEndpoint, budgets } from '../data/site';

interface Props {
  /** Shorter heading for the end of case study pages. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section id="contact" class="contact wrap" aria-labelledby="contact-title">
  <h2 id="contact-title" class:list={['title', 'display', { compact }]}>
    {compact ? 'Have a project in mind?' : 'Let’s make something that holds up.'}
  </h2>

  <div class="direct">
    <a href={whatsappUrl} class="btn btn-solid">WhatsApp {site.whatsappDisplay}</a>
    <a href={mailUrl} class="btn btn-line email">{site.email}</a>
  </div>
  <p class="extra no-print">
    <button type="button" class="tap copy js-only" data-copy={site.email}>
      <span data-copy-label>Copy email address</span>
    </button>
    <a href={site.linkedin} class="tap" rel="noopener">LinkedIn</a>
    <a href={site.github} class="tap" rel="noopener">GitHub</a>
  </p>
  <p class="sr-only" aria-live="polite" data-copy-status></p>

  <form class="form" action={web3formsEndpoint} method="POST" data-enquiry>
    <h3 class="display">Or send an enquiry</h3>
    <p class="form-note">Tell me a little about what you need. I will reply by email or WhatsApp. All fields except budget are required.</p>

    <input type="hidden" name="access_key" value={web3formsKey} />
    <input type="hidden" name="subject" value="New enquiry from the portfolio site" />
    <input type="hidden" name="from_name" value="Portfolio contact form" />
    <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />

    <div class="fields">
      <div class="field">
        <label for="f-name">Your name</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="f-name-err" />
        <p id="f-name-err" class="err" data-err></p>
      </div>
      <div class="field">
        <label for="f-email">Your email</label>
        <input id="f-email" name="email" type="email" autocomplete="email" required aria-describedby="f-email-err" />
        <p id="f-email-err" class="err" data-err></p>
      </div>
      <div class="field wide">
        <label for="f-budget">Budget <span class="opt">(optional, in USD)</span></label>
        <select id="f-budget" name="budget" autocomplete="off">
          <option value="">Choose a range</option>
          {budgets.map((b) => <option value={b}>{b}</option>)}
        </select>
      </div>
      <div class="field wide">
        <label for="f-message">Your message</label>
        <textarea id="f-message" name="message" rows="6" minlength="20" required aria-describedby="f-message-err"></textarea>
        <p id="f-message-err" class="err" data-err></p>
      </div>
    </div>

    <div class="actions">
      <button type="submit" class="btn btn-solid" data-submit>Send enquiry</button>
    </div>
    <div class="status" role="status" aria-live="polite" data-status tabindex="-1"></div>
    <template data-fallback>
      <a href={whatsappUrl}>WhatsApp</a> or <a href={mailUrl}>{site.email}</a>
    </template>
  </form>
</section>

<style>
  .contact {
    padding-top: var(--section);
    text-align: center;
  }
  .title {
    max-width: 1100px;
    margin-inline: auto;
    font-size: clamp(3.25rem, 8vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .title.compact {
    font-size: clamp(2.75rem, 6vw, 5.5rem);
  }
  .direct {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: clamp(32px, 4vw, 48px);
  }
  .email {
    overflow-wrap: anywhere;
  }
  .extra {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 28px;
    margin-top: 16px;
    font-size: 0.9375rem;
  }
  .copy {
    color: var(--gold);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  .copy:hover {
    color: var(--gold-hi);
  }
  :global(html:not(.js)) .js-only {
    display: none;
  }

  .form {
    max-width: 720px;
    margin: clamp(64px, 8vw, 112px) auto 0;
    padding-top: 48px;
    border-top: 1px solid var(--rule);
    text-align: left;
  }
  h3 {
    font-size: clamp(2.25rem, 3.4vw, 3rem);
    line-height: 1.05;
  }
  .form-note {
    margin-top: 10px;
    color: var(--muted);
    font-size: 1rem;
  }
  .fields {
    display: grid;
    gap: 22px 20px;
    margin-top: 32px;
  }
  label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .opt {
    color: var(--muted);
    font-weight: 400;
  }
  input,
  select,
  textarea {
    display: block;
    width: 100%;
    min-height: 52px;
    padding: 12px 22px;
    border: 1px solid var(--edge);
    border-radius: 26px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    line-height: 1.5;
    transition: border-color 0.3s;
  }
  textarea {
    min-height: 168px;
    padding-block: 16px;
    resize: vertical;
  }
  select {
    appearance: none;
    padding-right: 48px;
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%),
      linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
      calc(100% - 26px) 50%,
      calc(100% - 20px) 50%;
    background-size: 6px 6px;
    background-repeat: no-repeat;
  }
  option {
    background: #111;
    color: var(--text);
  }
  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--text);
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  [aria-invalid='true'] {
    border-color: var(--error);
    box-shadow: 0 0 0 1px var(--error);
  }
  .err {
    margin-top: 8px;
    color: var(--error);
    font-size: 0.9375rem;
  }
  .err:empty {
    display: none;
  }
  .actions {
    margin-top: 32px;
  }
  .actions .btn[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
  .status:empty {
    display: none;
  }
  .status {
    margin-top: 20px;
    padding: 14px 22px;
    border: 1px solid var(--gold);
    border-radius: 26px;
    line-height: 1.5;
  }
  .status:focus {
    outline: none;
  }
  @media (min-width: 640px) {
    .fields {
      grid-template-columns: 1fr 1fr;
    }
    .field.wide {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 420px) {
    .direct .btn {
      width: 100%;
      padding-inline: 16px;
    }
  }
  @media print {
    .form {
      display: none;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  if (btn) {
    const label = btn.querySelector('[data-copy-label]')!;
    const original = label.textContent;
    const status = btn.closest('section')?.querySelector('[data-copy-status]');
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          // Older or locked-down browsers: copy through a temporary selection.
          const area = document.createElement('textarea');
          area.value = text;
          area.setAttribute('readonly', '');
          area.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
          document.body.append(area);
          area.select();
          const ok = document.execCommand('copy');
          area.remove();
          btn.focus();
          if (!ok) throw new Error('copy failed');
        }
        label.textContent = 'Copied';
        if (status) status.textContent = 'Email address copied.';
      } catch {
        label.textContent = 'Copy failed';
        if (status) status.textContent = 'Could not copy. Use the email link instead.';
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = original;
        if (status) status.textContent = '';
      }, 2000);
    });
  }
</script>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-enquiry]');
  if (form) {
    form.noValidate = true;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const fallback = form.querySelector<HTMLTemplateElement>('[data-fallback]')!;
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]')];

    const messageFor = (el: HTMLInputElement | HTMLTextAreaElement): string => {
      const v = el.validity;
      if (v.valid) return '';
      if (el.name === 'name') return 'Please enter your name.';
      if (el.name === 'email') return v.valueMissing ? 'Please enter your email address.' : 'Please enter a valid email address, like name@example.com.';
      if (v.valueMissing) return 'Please write a short message.';
      return `Please write at least ${el.minLength} characters so I know what you need.`;
    };
    const check = (el: HTMLInputElement | HTMLTextAreaElement): boolean => {
      if (el.name === 'message') el.value.trim().length < el.minLength && el.setCustomValidity('short');
      const msg = messageFor(el);
      el.setCustomValidity('');
      const err = form.querySelector<HTMLElement>('#' + el.id + '-err')!;
      err.textContent = msg;
      if (msg) el.setAttribute('aria-invalid', 'true');
      else el.removeAttribute('aria-invalid');
      return !msg;
    };
    fields.forEach((el) => {
      el.addEventListener('blur', () => { if (el.value) check(el); });
      el.addEventListener('input', () => { if (el.getAttribute('aria-invalid')) check(el); });
    });

    const show = (text: string, withFallback = false) => {
      status.replaceChildren(text);
      if (withFallback) status.append(' ', ...fallback.content.cloneNode(true).childNodes, '.');
    };

    form.addEventListener('submit', async (event) => {
      const results = fields.map(check);
      const firstBad = fields[results.indexOf(false)];
      event.preventDefault();
      if (firstBad) {
        show('Please fix the highlighted fields and send again.');
        firstBad.focus();
        return;
      }
      button.disabled = true;
      button.textContent = 'Sending...';
      show('Sending your enquiry...');
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error('rejected');
        form.reset();
        show('Thank you. Your message has been sent. I will reply by email or WhatsApp.');
        button.textContent = 'Sent';
      } catch {
        show('Sorry, that did not send. Your message is still in the form. You can try again, or reach me on', true);
        button.disabled = false;
        button.textContent = 'Send enquiry';
      }
    });
  }
</script>
