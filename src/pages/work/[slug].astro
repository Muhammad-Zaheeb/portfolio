---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/site';
import { projectLd } from '../../data/schema';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
---

<Layout
  title={`${p.title} case study | Muhammad Zaheeb`}
  description={p.seoDescription}
  og={p.slug}
  ogType="article"
  ogAlt={`Case study card: ${p.title}. ${p.summary}`}
  jsonLd={[projectLd(p, Astro.site)]}
>
  <div id="top">
    <Header current="Work" />
  </div>
  <main id="main" tabindex="-1">
    <article class="wrap pt-24">
      <h1 class="h1">{p.title}</h1>
      <p class="mt-6 max-w-[56ch] text-text-2">{p.summary}</p>
    </article>
  </main>
  <Footer />
</Layout>
