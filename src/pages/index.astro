---
import Layout from '../layouts/Layout.astro';
import MessageCircle from '@lucide/astro/icons/message-circle';
---

<Layout>
  <main class="mx-auto max-w-2xl px-4 py-24">
    <h1 class="text-3xl font-semibold tracking-tight">
      I build fast, reliable websites and web apps for small businesses.
    </h1>
    <p class="mt-4 text-muted">Setup placeholder. Sections arrive in the next phase.</p>
    <a
      href="#"
      class="mt-8 inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 font-medium text-accent-fg"
    >
      <MessageCircle size={18} aria-hidden="true" />
      Talk on WhatsApp
    </a>
  </main>
</Layout>
