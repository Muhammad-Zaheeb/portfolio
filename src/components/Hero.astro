---
import { Image } from 'astro:assets';
import render from '../assets/event-horizon.jpg';
import { site, services, whatsappUrl } from '../data/site';

// Words fade in one after another; delays match the design.
const name = site.name.split(' ').map((word, i) => ({ word, delay: i * 0.18 }));
const tagline = site.tagline.split(' ').map((word, i) => ({ word, delay: 0.5 + i * 0.1 }));
const from = Math.min(...services.map((s) => s.price));
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="sky" aria-hidden="true">
    <Image src={render} alt="" width={1440} height={810} format="webp" quality={82} loading="eager" fetchpriority="high" class="render" data-render />
    <div class="shade"></div>
    <div class="lens" data-lens><canvas></canvas></div>
  </div>

  <div class="wrap content">
    <h1 id="hero-title" class="name display">
      {name.map((w) => <><span class="word" style={`animation-delay:${w.delay}s`}>{w.word}</span>{' '}</>)}
    </h1>
    <div class="below">
      <p class="tagline display">
        {tagline.map((w) => <><span class="word" style={`animation-delay:${w.delay.toFixed(1)}s`}>{w.word}</span>{' '}</>)}
      </p>
      <div class="intro fade" style="animation-delay:1.2s">
        <p>
          Computer science student at <span class="nowrap">{site.university}</span>. Behind my name is a frame from Event
          Horizon, a live black hole renderer I conceived and directed. I also build websites for small businesses, from ${from}.
        </p>
        <div class="actions">
          <a href="#story" class="btn btn-solid">See how it works</a>
          <a href={whatsappUrl} class="btn btn-line">WhatsApp me</a>
        </div>
      </div>
    </div>
  </div>

  <p class="hint fade no-print" style="animation-delay:1.4s">Move your cursor. The lens follows it and magnifies the light behind.</p>
</section>

<script>
  import { startLens } from '../scripts/lens';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) startLens(hero);
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: clamp(640px, 100vh, 980px);
    min-height: clamp(640px, 100svh, 980px);
  }
  .sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
    contain: strict;
  }
  .render {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    opacity: 0.62;
  }
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0) 45%, rgb(0 0 0 / 0.9));
  }
  .lens {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 1.2s ease;
    will-change: transform;
    pointer-events: none;
  }
  .lens.is-ready {
    opacity: 1;
  }
  .lens canvas {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }
  /* Soft inner edge and the two gold rings. */
  .lens::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgb(233 201 143 / 0.7);
    background: radial-gradient(closest-side, transparent 84%, rgb(0 0 0 / 0.55));
  }
  .lens::after {
    content: '';
    position: absolute;
    inset: -8.5px;
    border-radius: 50%;
    border: 1px solid rgb(233 201 143 / 0.18);
  }

  .content {
    position: relative;
    margin-top: auto;
    /* Clears the header that sits over the render. */
    padding-top: 148px;
    padding-bottom: clamp(40px, 5vw, 72px);
  }
  .name {
    font-size: clamp(3.5rem, 16vw, 6rem);
    line-height: 0.86;
    letter-spacing: -0.03em;
  }
  .below {
    display: grid;
    gap: 24px 64px;
    margin-top: clamp(24px, 3vw, 36px);
    padding-top: clamp(20px, 2.4vw, 28px);
    border-top: 1px solid rgb(236 231 223 / 0.22);
    align-items: end;
  }
  .tagline {
    font-size: clamp(2rem, 3.3vw, 3rem);
    font-style: italic;
    line-height: 1.05;
    text-wrap: balance;
  }
  .intro {
    max-width: 460px;
  }
  .intro p {
    color: var(--text-2);
    font-size: 1.0625rem;
  }
  .nowrap {
    white-space: nowrap;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .hint {
    display: none;
    position: absolute;
    right: max(var(--pad), calc((100% - 1320px) / 2 + var(--pad)));
    top: 96px;
    max-width: 220px;
    color: var(--soft);
    font-size: 0.8125rem;
    text-align: right;
  }

  /* On phones the text sits over the bright disk, so the shade starts higher. */
  @media (max-width: 860px) {
    .shade {
      background: linear-gradient(180deg, rgb(0 0 0 / 0) 24%, rgb(0 0 0 / 0.55) 56%, rgb(0 0 0 / 0.92));
    }
  }
  @media (max-width: 420px) {
    .actions .btn {
      padding-inline: 20px;
    }
  }
  @media (min-width: 861px) {
    .name {
      font-size: clamp(6rem, 11.5vw, 11.5rem);
    }
    .intro p {
      font-size: 1.125rem;
    }
    .actions {
      margin-top: 28px;
    }
  }
  @media (min-width: 1000px) {
    .below {
      grid-template-columns: 1fr 1fr;
    }
    .intro {
      justify-self: end;
    }
  }
  /* The hint only makes sense with a cursor and a script. */
  @media (min-width: 861px) and (hover: hover) and (pointer: fine) {
    :global(.js) .hint {
      display: block;
    }
  }
  /* Short laptop screens: keep the buttons in view. */
  @media (min-width: 861px) and (max-height: 760px) {
    .name {
      font-size: clamp(6rem, min(11.5vw, 19svh), 11.5rem);
    }
    .hint {
      top: 84px;
    }
  }

  .word {
    display: inline-block;
    opacity: 0;
    animation: word 1.4s cubic-bezier(0.2, 0.7, 0.1, 1) forwards;
  }
  @keyframes word {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(0.25em);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }
  .fade {
    opacity: 0;
    animation: fade 1.6s ease forwards;
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  /* A keyboard visitor who tabs ahead of the fade still sees where they are. */
  .fade:focus-within {
    opacity: 1;
    animation: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .word,
    .fade {
      opacity: 1;
      animation: none;
    }
    .lens {
      transition: none;
    }
  }
  @media print {
    .sky {
      display: none;
    }
    .hero {
      min-height: 0;
    }
    .word,
    .fade {
      opacity: 1;
      animation: none;
    }
  }
</style>
